{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cellcast hub values",
  "description": "A bad value here fails at install rather than at the first deploy that needed the hub.",
  "type": "object",
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$",
      "description": "An integer with an ms, s, m or h suffix. The chart does arithmetic on these, so a compound duration like 1h30m is deliberately not accepted."
    }
  },
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["registry", "repository"]
    },
    "hub": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "registryNamespace": { "type": "string" },
        "tokenMaxTTL": { "$ref": "#/definitions/duration" },
        "warmupTimeout": { "$ref": "#/definitions/duration" },
        "drainDelay": { "$ref": "#/definitions/duration" },
        "shutdownTimeout": { "$ref": "#/definitions/duration" },
        "readHeaderTimeout": { "$ref": "#/definitions/duration" },
        "capacity": {
          "type": "object",
          "properties": {
            "staleness": { "$ref": "#/definitions/duration" },
            "retention": { "$ref": "#/definitions/duration" },
            "maxCells": { "type": "integer", "minimum": 1 }
          }
        },
        "leaderElection": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "audience": { "type": "string", "minLength": 1 },
            "issuers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://",
                    "description": "Issuer URL. Compared literally against the token's iss claim, and https because the JWKS behind it is fetched over the network."
                  },
                  "provider": { "type": "string", "minLength": 1 }
                },
                "required": ["url", "provider"]
              }
            },
            "clockSkew": { "$ref": "#/definitions/duration" },
            "refreshInterval": { "$ref": "#/definitions/duration" },
            "httpTimeout": { "$ref": "#/definitions/duration" }
          }
        },
        "extraArgs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ports": {
      "type": "object",
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "probe": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metrics": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "crds": {
      "type": "object",
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": { "create": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Must exceed drainDelay plus shutdownTimeout. The chart refuses to render if it does not."
    },
    "updateStrategy": { "type": "object" },
    "resources": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "affinity": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "$ref": "#/definitions/duration" },
            "scrapeTimeout": { "$ref": "#/definitions/duration" },
            "labels": { "type": "object" },
            "metricRelabelings": { "type": "array" },
            "relabelings": { "type": "array" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedIngress": { "type": "array" },
        "metricsAllowedIngress": { "type": "array" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
